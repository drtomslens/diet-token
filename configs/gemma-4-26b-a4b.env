# Google Gemma 4 26B-A4B preset for 32 GB MacBook Pro (M1 Max)
# Store heavy weight files OUTSIDE Google Drive to avoid sync/quota issues.

MODEL_NAME="gemma-4-26b-a4b"
BACKEND="llama-server"   # Options: llama-server | mlx

# Local SSD path (outside cloud-synced folders)
MODEL_DIR="$HOME/local-llms/models/gemma-4-26b-a4b"
HF_REPO="unsloth/gemma-4-26B-A4B-it-GGUF"
HF_FILE="gemma-4-26B-A4B-it-Q4_0.gguf"

MODEL_FILE="$MODEL_DIR/$HF_FILE"
MMPROJ_FILE="$MODEL_DIR/mmproj-gemma-4-26B-A4B-it-Q8_0.gguf"

# Sliding-window + global attention keeps KV tiny even at 64K context
CTX_SIZE=65536
KV_CACHE_TYPE="q8_0"

# Google official recommended sampling for Gemma 4
TEMP="1.0"
TOP_P="0.95"
TOP_K="64"
MIN_P="0.0"
REASONING_BUDGET="2048"  # set to 0 for instant non-thinking mode

HOST="127.0.0.1"
PORT=8080
