# Qwen3-8B preset for 16 GB & 24 GB Apple Silicon Macs (M1/M2/M3/M4 Air & Pro)
# Only ~5.0 GB on disk/VRAM — fast, reliable, 32K context.

MODEL_NAME="qwen3-8b"
BACKEND="llama-server"   # Options: llama-server | mlx

MODEL_DIR="$HOME/local-llms/models/qwen3-8b"
HF_REPO="unsloth/Qwen3-8B-GGUF"
HF_FILE="Qwen3-8B-Q4_K_M.gguf"
MODEL_FILE="$MODEL_DIR/$HF_FILE"

CTX_SIZE=32768
KV_CACHE_TYPE="q8_0"

TEMP="0.7"
TOP_P="0.8"
TOP_K="20"
MIN_P="0.0"
REASONING_BUDGET="0"

HOST="127.0.0.1"
PORT=8080
