# Inkling 2 Mini preset for 32 GB MacBook Pro (M1 Max)
# Store actual heavy weight files OUTSIDE cloud-synced folders to avoid sync/quota issues.

MODEL_NAME="inkling-2-mini"
BACKEND="llama-server"   # Options: llama-server | mlx

# Local SSD path (outside cloud-synced folders)
MODEL_DIR="$HOME/local-llms/models/inkling-2-mini"

# Update filename to match the exact GGUF quant you download (e.g. Q4_K_M or IQ4_NL)
MODEL_FILE="$MODEL_DIR/Inkling-2-Mini-IQ4_NL.gguf"

# Vision projector for plots/images
MMPROJ_FILE="$MODEL_DIR/mmproj-Inkling-2-Mini-Q8_0.gguf"

# Safe 32 GB M1 Max settings (fits inside macOS 24 GB default Metal wired limit)
CTX_SIZE=24576
KV_CACHE_TYPE="q8_0"     # official recommended KV precision for 48-layer looped core

# Thinking Machines recommended sampling + reasoning cap to prevent 7-min spirals
TEMP="0.8"
TOP_P="0.95"
TOP_K="0"
MIN_P="0.0"
REASONING_BUDGET="1024"

HOST="127.0.0.1"
PORT=8080
