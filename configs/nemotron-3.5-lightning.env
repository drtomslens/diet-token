# NVIDIA Nemotron-3.5-Lightning-30B-A3B preset for 32 GB MacBook Pro (M1 Max)
# Hybrid Mamba-2 + MoE (3B active) — tiny KV cache even at 128K context!

MODEL_NAME="nemotron-3.5-lightning"
BACKEND="llama-server"   # Options: llama-server | mlx

# Local SSD path (outside cloud-synced folders)
MODEL_DIR="$HOME/local-llms/models/nemotron-3.5-lightning"
HF_REPO="bartowski/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-GGUF"
HF_FILE="NVIDIA-Nemotron-3.5-Lightning-30B-A3B-Q4_0.gguf"
MODEL_FILE="$MODEL_DIR/$HF_FILE"

# Mamba-2 hybrid layers keep KV memory tiny at long context
CTX_SIZE=131072
KV_CACHE_TYPE="q8_0"

# NVIDIA official recommended sampling + reasoning budget cap
TEMP="1.0"
TOP_P="0.95"
TOP_K="0"
MIN_P="0.0"
REASONING_BUDGET="2048"  # set to 0 for instant non-thinking mode

HOST="127.0.0.1"
PORT=8080
